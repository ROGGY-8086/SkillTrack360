rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // Payrolls subcollection
      match /payrolls/{payrollId} {
        allow read, write: if isOwner(userId) && isValidId(payrollId);
      }

      // Employees subcollection
      match /employees/{employeeId} {
        allow read, write: if isOwner(userId) && isValidId(employeeId);
      }

      // Benefits subcollection
      match /benefits/{benefitId} {
        allow read, write: if isOwner(userId) && isValidId(benefitId);
      }

      // AI Tasks subcollection
      match /ai_tasks/{taskId} {
        allow read, write: if isOwner(userId) && isValidId(taskId);
      }
    }
  }
}
